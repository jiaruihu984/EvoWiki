{
 "component_id": "step-process",
 "name": "分步过程",
 "description": "把一个过程拆成几步，每步用表格或方框显示当前状态，变化的格子被标出；上一步/下一步逐步看，可选在某一步故意出错，看错误怎样一路传下去，再回到正确路径。",
 "learning_question": "这个过程每一步改变了什么？某一步出错会怎样传下去？",
 "scenarios": [
  "DNA 复制",
  "二分查找",
  "算法执行过程",
  "协议握手",
  "推导步骤",
  "化学反应步骤",
  "游戏流程"
 ],
 "params": {
  "步骤": "上一步、下一步、重来",
  "故意出错": "在指定的一步切到出错路径，看后果，再回到正确路径"
 },
 "html_path": "src/evowiki/deep/components/step-process.html",
 "height": 600,
 "probes": [
  {
   "target": "#next",
   "action": "click",
   "expect_change": "#result"
  },
  {
   "target": "#reset",
   "action": "click",
   "expect_change": "#result"
  }
 ],
 "source": "component-library: step-through with a deliberate mistake, from the replication / pairing prototypes",
 "config_schema": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "title",
   "question",
   "layout",
   "columns",
   "steps",
   "mistake"
  ],
  "properties": {
   "title": {
    "type": "string",
    "description": "组件标题，说清是什么过程"
   },
   "question": {
    "type": "string",
    "description": "这个交互回答的学习问题，一句话"
   },
   "layout": {
    "type": "string",
    "enum": [
     "table",
     "boxes"
    ],
    "description": "状态怎么画：table 是表格（有列标题），boxes 是一排排带名字的方框"
   },
   "columns": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "layout 为 table 时的列标题（如下标 0,1,2…），与每行格数对应；boxes 或不需要时给空数组"
   },
   "steps": {
    "type": "array",
    "minItems": 1,
    "description": "正确做法的 3–10 个步骤，按顺序",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "title",
      "explain",
      "rows"
     ],
     "properties": {
      "title": {
       "type": "string",
       "description": "这一步的短标题（一行），说清这一步做了什么"
      },
      "explain": {
       "type": "string",
       "description": "1–2 句话解释这一步为什么这样做"
      },
      "rows": {
       "type": "array",
       "minItems": 1,
       "description": "这一步的状态：表格或方框的若干行；所有步骤的行数、每行格数保持一致，便于对比",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "label",
         "cells"
        ],
        "properties": {
         "label": {
          "type": "string",
          "description": "这一行的名字（短），没有就给空字符串"
         },
         "cells": {
          "type": "array",
          "minItems": 1,
          "description": "这一行的格子，最多 12 个",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "text",
            "changed"
           ],
           "properties": {
            "text": {
             "type": "string",
             "description": "格子里的短字符串（几个字以内）"
            },
            "changed": {
             "type": "boolean",
             "description": "这一步这一格是新出现或改变的就为 true"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "mistake": {
    "anyOf": [
     {
      "type": "null"
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "at_step",
       "button_label",
       "consequence",
       "wrong_steps"
      ],
      "properties": {
       "at_step": {
        "type": "integer",
        "description": "在第几步（从 1 数起）出现“故意出错”按钮；按下后这一步起改走 wrong_steps"
       },
       "button_label": {
        "type": [
         "string",
         "null"
        ],
        "description": "按钮文字，null 时用“在这一步故意出错”"
       },
       "consequence": {
        "type": "string",
        "description": "出错路径上一直显示的后果说明，一两句，说清错误为什么会传下去"
       },
       "wrong_steps": {
        "type": "array",
        "minItems": 1,
        "description": "从 at_step 起的出错版本：第 1 项替换正确的第 at_step 步，之后依次替换；格子结构要和正确步骤对应，才能标出哪一格错了",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "title",
          "explain",
          "rows"
         ],
         "properties": {
          "title": {
           "type": "string",
           "description": "这一步的短标题（一行），说清这一步做了什么"
          },
          "explain": {
           "type": "string",
           "description": "1–2 句话解释这一步为什么这样做"
          },
          "rows": {
           "type": "array",
           "minItems": 1,
           "description": "这一步的状态：表格或方框的若干行；所有步骤的行数、每行格数保持一致，便于对比",
           "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "label",
             "cells"
            ],
            "properties": {
             "label": {
              "type": "string",
              "description": "这一行的名字（短），没有就给空字符串"
             },
             "cells": {
              "type": "array",
              "minItems": 1,
              "description": "这一行的格子，最多 12 个",
              "items": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                "text",
                "changed"
               ],
               "properties": {
                "text": {
                 "type": "string",
                 "description": "格子里的短字符串（几个字以内）"
                },
                "changed": {
                 "type": "boolean",
                 "description": "这一步这一格是新出现或改变的就为 true"
                }
               }
              }
             }
            }
           }
          }
         }
        }
       }
      }
     }
    ],
    "description": "可选：学习者可以故意走错的一处；不需要就 null"
   }
  }
 },
