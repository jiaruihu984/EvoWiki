{
  "component_id": "code-trace",
  "name": "代码追踪",
  "description": "把几行代码和一份事先写好的执行轨迹放在一起：逐步或拖动滑块前进后退，高亮当前行，看变量表（标出变了的）和输出一步步变化。代码只显示，不会被运行。",
  "learning_question": "这段代码每一步执行到哪一行？变量此刻是多少？为什么输出是这样的顺序？",
  "scenarios": [
    "循环与累加",
    "递归与调用栈",
    "变量赋值",
    "执行顺序",
    "异步与事件循环",
    "代码阅读",
    "手动追踪"
  ],
  "params": {
    "code": "要显示的几行代码",
    "language": "语言标签",
    "steps": "每一步：行号、变量表、新增输出、一句解释"
  },
  "html_path": "src/evowiki/deep/components/code-trace.html",
  "height": 620,
  "probes": [
    {
      "target": "#next",
      "action": "click",
      "expect_change": "#result"
    },
    {
      "target": "#slider",
      "action": "input",
      "value": "2",
      "expect_change": "#result"
    }
  ],
  "source": "component-library: explicit-trace stepper (display only, never executes config code)",
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "question",
      "language",
      "code",
      "steps"
    ],
    "properties": {
      "title": {
        "type": "string",
        "description": "组件标题，说明追踪的是哪段代码、讲什么"
      },
      "question": {
        "type": "string",
        "description": "学习问题，一句话"
      },
      "language": {
        "type": "string",
        "description": "语言名，如 Python、JavaScript；只用于显示"
      },
      "code": {
        "type": "array",
        "minItems": 1,
        "description": "3–20 行代码，每个元素是一行，不含行号，保留缩进空格。只用来显示，永远不会被运行",
        "items": {
          "type": "string"
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "description": "4–30 个追踪步骤，按执行顺序；你必须自己算好每一步的变量值，组件不会运行代码",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "vars",
            "output",
            "explain"
          ],
          "properties": {
            "line": {
              "type": "number",
              "description": "这一步正要执行 / 刚执行的行号，从 1 开始"
            },
            "vars": {
              "type": "array",
              "description": "这一步结束后所有相关变量的值（每一步都完整列出，同名变量用同样的名字，这样才能标出哪些变了）；没有变量就空数组",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "变量名"
                  },
                  "value": {
                    "type": "string",
                    "description": "值，写成显示的文字，如 [3, 5, 2]"
                  }
                }
              }
            },
            "output": {
              "type": [
                "string",
                "null"
              ],
              "description": "这一步新增的一行输出；没有输出就 null"
            },
            "explain": {
              "type": "string",
              "description": "一句话：这一步发生了什么、为什么"
            }
          }
        }
      }
    }
  },
