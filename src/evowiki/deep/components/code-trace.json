          "line": 3,
          "vars": [
            {
              "name": "宏任务队列",
              "value": "[]"
            },
            {
              "name": "微任务队列",
              "value": "[]"
            }
          ],
          "output": "B",
          "explain": "微任务清空后，才轮到宏任务：执行回调 B，输出 B。最终顺序是 A D C B。"
        }
      ]
