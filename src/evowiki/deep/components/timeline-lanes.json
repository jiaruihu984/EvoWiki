{
 "component_id": "timeline-lanes",
 "name": "时间线 / 泳道",
 "description": "把几件事画成并排的泳道：每条泳道上是一段段“干活 / 等待 / 传输 / 事件”，红线随时间移动，读数说明此刻每条泳道在做什么；可以切换两种做法，比较总耗时。",
 "learning_question": "几件事在时间上怎样排布？为什么换一种安排，总时间就不同？",
 "scenarios": [
  "同步与异步",
  "并发与并行",
  "流水线",
  "多任务排程",
  "历史事件的先后与重叠",
  "人物生平对照",
  "厨房里同时做几道菜"
 ],
 "params": {
  "播放": "红线自动向右移动，到终点自动停",
  "当前时间": "拖动滑块，把红线放到任何时刻",
  "方案": "有两个方案时切换，比较总耗时"
 },
 "html_path": "src/evowiki/deep/components/timeline-lanes.html",
 "height": 640,
 "probes": [
  {
   "target": "#scrub",
   "action": "input",
   "value": "500",
   "expect_change": "#result"
  },
  {
   "target": "#play",
   "action": "click",
   "expect_change": "#result"
  }
 ],
 "source": "component-library: lanes/timeline with scrubber and optional second scenario",
 "config_schema": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "title",
   "question",
   "time_unit",
   "total_label",
   "kind_names",
   "scenarios"
  ],
  "properties": {
   "title": {
    "type": "string",
    "description": "组件标题，说清比较的是什么"
   },
   "question": {
    "type": "string",
    "description": "这个交互回答的学习问题，一句话"
   },
   "time_unit": {
    "type": [
     "string",
     "null"
    ],
    "description": "时间单位，如 秒、年；没有就 null"
   },
   "total_label": {
    "type": [
     "string",
     "null"
    ],
    "description": "要显示每个方案的总用时时的名字，如 总耗时；不需要比较总时长（如历史）就 null"
   },
   "kind_names": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "work",
     "wait",
     "io",
     "event"
    ],
    "properties": {
     "work": {
      "type": [
       "string",
       "null"
      ],
      "description": "work 在这个主题里叫什么，null 用默认“工作”"
     },
     "wait": {
      "type": [
       "string",
       "null"
      ],
      "description": "wait 的名字，null 用“等待”"
     },
     "io": {
      "type": [
       "string",
       "null"
      ],
      "description": "io 的名字，null 用“传输/读写”"
     },
     "event": {
      "type": [
       "string",
       "null"
      ],
      "description": "event 的名字，null 用“事件”"
     }
    }
   },
   "scenarios": {
    "type": "array",
    "minItems": 1,
    "description": "1 或 2 个方案；两个方案时学习者可以切换并比较总用时",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "note",
      "lanes"
     ],
     "properties": {
      "name": {
       "type": "string",
       "description": "这种做法的名字，如 同步 / 异步"
      },
      "note": {
       "type": "string",
       "description": "切到这个方案或播放结束时显示的一两句话，说清为什么是这个结果"
      },
      "lanes": {
       "type": "array",
       "minItems": 1,
       "description": "1–4 条泳道；两个方案里泳道名字尽量相同",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "name",
         "events"
        ],
        "properties": {
         "name": {
          "type": "string",
          "description": "泳道名（短）"
         },
         "events": {
          "type": "array",
          "minItems": 1,
          "description": "这条泳道上的安排，按开始时间排序",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "start",
            "duration",
            "label",
            "kind"
           ],
           "properties": {
            "start": {
             "type": "number",
             "description": "开始时间，数字（用 time_unit 这个单位；历史可以直接写年份）"
            },
            "duration": {
             "type": "number",
             "description": "持续多久，同单位；kind 是 event 时写 0"
            },
            "label": {
             "type": "string",
             "description": "条上的短文字（几个字，最多 8 个汉字）"
            },
            "kind": {
             "type": "string",
             "enum": [
              "work",
              "wait",
              "io",
              "event"
             ],
             "description": "work 实心条（在干活/在世），wait 斜线条（等待/空闲），io 点点条（传输/读写），event 菱形（某一刻发生的事）"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  }
 },
