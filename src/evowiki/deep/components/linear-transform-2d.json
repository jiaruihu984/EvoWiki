{
  "component_id": "linear-transform-2d",
  "name": "二维线性变换",
  "description": "一个 2×2 矩阵把平面网格、单位方块和向量变形；滑块 t 从单位矩阵渐变到 A，可旋转向量 v，读行列式（面积倍数）并标出特征方向与特征值。",
  "learning_question": "矩阵对平面做了什么？哪些方向只被拉伸而不被转动？",
  "scenarios": [
    "线性变换",
    "矩阵与向量",
    "行列式",
    "特征值与特征向量",
    "剪切与拉伸",
    "协方差矩阵",
    "PCA 直觉"
  ],
  "params": {
    "t": "从单位矩阵渐变到 A 的程度",
    "向量 v": "旋转向量，看 Av 的方向和长度",
    "矩阵": "在配置给出的几个矩阵之间切换"
  },
  "html_path": "src/evowiki/deep/components/linear-transform-2d.html",
  "height": 720,
  "probes": [
    {
      "target": "#t",
      "action": "input",
      "value": "40",
      "expect_change": "#result"
    },
    {
      "target": "#rot-ccw",
      "action": "click",
      "expect_change": "#result"
    },
    {
      "target": "#reset",
      "action": "click",
      "expect_change": "#result"
    }
  ],
  "source": "component-library: 2x2 linear transform with grid, det and eigen-directions",
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "question",
      "axis_x",
      "axis_y",
      "view",
      "matrices",
      "vector",
      "show_square",
      "show_eigen"
    ],
    "properties": {
      "title": {
        "type": "string",
        "description": "组件标题，说明这些变换是什么"
      },
      "question": {
        "type": "string",
        "description": "学习问题，一句话"
      },
      "axis_x": {
        "type": "string",
        "description": "横轴（第一个坐标）的名字，如 x、身高"
      },
      "axis_y": {
        "type": "string",
        "description": "纵轴（第二个坐标）的名字"
      },
      "view": {
        "type": "number",
        "description": "坐标范围为 −view 到 view，常取 3 或 4，要能装下变换后的单位方块和向量"
      },
      "matrices": {
        "type": "array",
        "minItems": 1,
        "description": "1–4 个可切换的 2×2 矩阵 [[a,b],[c,d]]，各元素的绝对值不超过 4",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "a",
            "b",
            "c",
            "d",
            "meaning"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "矩阵的名字，如 剪切、拉伸"
            },
            "a": {
              "type": "number",
              "description": "第一行第一列"
            },
            "b": {
              "type": "number",
              "description": "第一行第二列"
            },
            "c": {
              "type": "number",
              "description": "第二行第一列"
            },
            "d": {
              "type": "number",
              "description": "第二行第二列"
            },
            "meaning": {
              "type": [
                "string",
                "null"
              ],
              "description": "一句话说明这个变换做了什么（切换到它时显示），没有就 null"
            }
          }
        }
      },
      "vector": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "description": "学习者要旋转的向量 v 的初始位置（长度之后保持不变）",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "show_square": {
        "type": "boolean",
        "description": "是否画单位方块及其变换后的平行四边形"
      },
      "show_eigen": {
        "type": "boolean",
        "description": "是否画特征方向（有实特征值时）"
      }
    }
  },
  "example_configs": [
    {
      "title": "剪切、拉伸和旋转：网格被矩阵怎样变形",
      "question": "拖动 t，看方格怎样从原样变成 A 的样子；哪些方向在变换后仍然指向原来的方向？",
      "axis_x": "x",
      "axis_y": "y",
      "view": 3,
      "matrices": [
        {
          "name": "剪切",
          "a": 1,
          "b": 1,
          "c": 0,
          "d": 1,
          "meaning": "横向错切：y 越大，点被推得越远；面积不变，只有横轴方向没被转动。"
        },
        {
          "name": "拉伸",
          "a": 2,
          "b": 0,
          "c": 0,
          "d": 0.5,
          "meaning": "x 方向拉长 2 倍、y 方向压到一半；坐标轴方向保持不变，面积还是 1。"
        },
        {
          "name": "旋转 90°",
          "a": 0,
          "b": -1,
          "c": 1,
          "d": 0,
          "meaning": "整体逆时针转 90°；任何方向都被转走了，所以没有实特征方向。"
        }
      ],
      "vector": {
        "x": 0.5,
        "y": 1.5
      },
      "show_square": true,
      "show_eigen": true
    },
    {
      "title": "协方差矩阵：数据云被拉向哪里",
      "question": "把一个向量转一圈：在哪个方向上它被拉得最长？这就是 PCA 要找的主方向。",
      "axis_x": "身高（标准化）",
      "axis_y": "体重（标准化）",
      "view": 4,
      "matrices": [
        {
          "name": "两个量强相关",
          "a": 3,
          "b": 1.5,
          "c": 1.5,
          "d": 1.5,
          "meaning": "对称矩阵：两个特征方向互相垂直；较大的特征值是最长方向上的方差，那条线就是主方向。"
        },
        {
          "name": "几乎不相关",
          "a": 2,
          "b": 0.2,
          "c": 0.2,
          "d": 1,
          "meaning": "非对角元素很小，特征方向几乎沿着坐标轴：两个量各变各的。"
        }
      ],
      "vector": {
        "x": 1,
        "y": 0
      },
      "show_square": false,
      "show_eigen": true
    }
  ]
}