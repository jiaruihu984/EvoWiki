# UTF-8。init 会创建 .env；可先无密钥启动，再在应用首次设置中填写。不要提交 .env。
# Start without a key, then configure the model in Initial setup. Never commit .env.
# Optional backup retention (1–365 completed backups); default is 14.
# EVOWIKI_BACKUP_KEEP=14
# Windows 一键启动会创建这个本地数据库，无需手动安装 PostgreSQL。
EVOWIKI_DATABASE_URL=postgresql://evowiki_app:@127.0.0.1:15432/postgres
EVOWIKI_ADMIN_DATABASE_URL=postgresql://postgres:@127.0.0.1:15432/postgres

# auto 按已配置密钥选择；也可指定 anthropic / deepseek / openai / gemini / kimi / glm / openai_compatible。
# 只填要使用的供应商，无需补填其他家的密钥。
EVOWIKI_RUNTIME_PROVIDER=auto
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
EVOWIKI_COMPATIBLE_API_KEY=
# 自定义兼容服务必须填写实际地址和模型名。
EVOWIKI_COMPATIBLE_BASE_URL=
EVOWIKI_COMPATIBLE_MODEL=
# 仅在服务和模型明确支持图片时开启；未知模型默认不支持。
EVOWIKI_COMPATIBLE_VISION=false

# 可选：覆盖供应商默认模型。
# EVOWIKI_OPENAI_MODEL=gpt-5.2
# EVOWIKI_GEMINI_MODEL=gemini-2.5-flash
# EVOWIKI_KIMI_MODEL=kimi-k3.1-pro
# EVOWIKI_GLM_MODEL=glm-5.3
# 可选：模型选择器的模型清单（英文逗号分隔）；不填写时显示默认模型。
# EVOWIKI_ANTHROPIC_MODELS=claude-sonnet-5-5
# EVOWIKI_DEEPSEEK_MODELS=deepseek-v4-pro
# EVOWIKI_OPENAI_MODELS=gpt-5.2
# EVOWIKI_GEMINI_MODELS=gemini-2.5-flash
# EVOWIKI_KIMI_MODELS=kimi-k3.1-pro
# EVOWIKI_GLM_MODELS=glm-5.3
# EVOWIKI_COMPATIBLE_MODELS=your-model-id
# 额外模型需提供价格；TOML 格式参考 src/evowiki/llm/prices.toml。
EVOWIKI_PRICES_FILE=

# cpu 适用于所有支持的电脑。NVIDIA 用户准备好驱动后可改成 cuda。
EVOWIKI_EMBED_PROVIDERS=cpu

# 留空使用仓库内新建的 .evowiki-vault。也可填已有 Obsidian 库的绝对路径。
EVOWIKI_VAULT=

# 选配：联网搜索；未填写时其余功能仍可使用。
TAVILY_API_KEY=
# 选配：本地版面解析（MinerU / Docling）独立环境的 python.exe，用 scripts/setup_layout_env.py 创建；也可用 Claude 读取扫描页。
EVOWIKI_LAYOUT_PYTHON=

# 新安装默认不导出轨迹、不生成工具或修改代码；按 README 显式选配。
EVOWIKI_OTEL_ENDPOINT=
EVOWIKI_FORGE=off

# 删除会话的库外记录（不随数据库备份恢复）。留空使用仓库下的 .evowiki-run/forget-ledger.jsonl。
EVOWIKI_FORGET_LEDGER=
